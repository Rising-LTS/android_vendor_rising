prebuilt_etc_xml {
    name: "sensitive_pn.xml",
    product_specific: true,
    src: "etc/sensitive_pn.xml",
    schema: ":spn-schema",
}

android_app_import {
	name: "GrapheneCamera",
	apk: "apps/GrapheneCamera.apk",
	presigned: true,
	privileged: true,
	dex_preopt: {
		enabled: false,
	},
	product_specific: true,
}

java_import {
    name: "vendor.aac.hardware.richtap.vibrator",
    jars: ["lib/vendorAacHardwareRichtapVibrator.jar"],
    sdk_version: "current",
}
